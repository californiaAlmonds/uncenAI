{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start UncenAI Colab T4 GPU",
      "type": "shell",
      "command": "py",
      "args": ["${workspaceFolder}/src/local_controller.py", "start", "--backend", "colab", "--wait"],
      "options": {
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
